    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb" },
          "description": "Latest value. Axis min/max from scale tags. Click → OPC Structure Measure for this prefix.",
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "links": [
                {
                  "title": "Open structure detail",
                  "url": "/d/level2-opc-structure/opc-structure-measure?var-structure=${structure}&from=${__from}&to=${__to}",
                  "targetBlank": true
                }
              ],
              "mappings": [],
              "max": 100,
              "min": 0,
              "thresholds": {
                "mode": "percentage",
                "steps": [
                  { "color": "green", "value": null },
                  { "color": "yellow", "value": 80 },
                  { "color": "red", "value": 90 }
                ]
              },
              "unit": "none"
            },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
          "id": 101,
          "links": [
            {
              "title": "Open structure detail",
              "url": "/d/level2-opc-structure/opc-structure-measure?var-structure=${structure}&from=${__from}&to=${__to}",
              "targetBlank": true
            }
          ],
          "options": {
            "minVizHeight": 75,
            "minVizWidth": 75,
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
            "showThresholdLabels": false,
            "showThresholdMarkers": true,
            "sizing": "auto"
          },
          "targets": [
            {
              "datasource": { "type": "postgres", "uid": "timescaledb" },
              "editorMode": "code",
              "format": "time_series",
              "rawQuery": true,
              "rawSql": "SELECT\n  time AS \"time\",\n  value_num AS \"value\"\nFROM collector.samples\nWHERE\n  tag_id IN ('${structure}_rvalueout', '${structure}_realvalue')\n  AND $__timeFilter(time)\nORDER BY 1",
              "refId": "A"
            },
            {
              "datasource": { "type": "postgres", "uid": "timescaledb" },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT value_num AS \"min\"\nFROM collector.samples\nWHERE tag_id IN ('${structure}_strscale_min', '${structure}_min_scale')\nORDER BY time DESC\nLIMIT 1",
              "refId": "Min"
            },
            {
              "datasource": { "type": "postgres", "uid": "timescaledb" },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT value_num AS \"max\"\nFROM collector.samples\nWHERE tag_id IN ('${structure}_strscale_max', '${structure}_max_scale')\nORDER BY time DESC\nLIMIT 1",
              "refId": "Max"
            }
          ],
          "title": "Value",
          "transformations": [
            {
              "id": "configFromData",
              "options": {
                "configRefId": "Min",
                "mappings": [
                  {
                    "fieldName": "min",
                    "handlerKey": "min",
                    "reducerId": "lastNotNull"
                  }
                ]
              }
            },
            {
              "id": "configFromData",
              "options": {
                "configRefId": "Max",
                "mappings": [
                  {
                    "fieldName": "max",
                    "handlerKey": "max",
                    "reducerId": "lastNotNull"
                  }
                ]
              }
            }
          ],
          "type": "gauge"
        },
        {
          "datasource": { "type": "postgres", "uid": "timescaledb" },
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "links": [
                {
                  "title": "Open structure detail",
                  "url": "/d/level2-opc-structure/opc-structure-measure?var-structure=${structure}&from=${__from}&to=${__to}",
                  "targetBlank": true
                }
              ],
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [{ "color": "blue", "value": null }]
              }
            },
            "overrides": []
          },
          "gridPos": { "h": 8, "w": 4, "x": 8, "y": 1 },
          "id": 102,
          "options": {
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto",
            "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": false },
            "textMode": "value"
          },
          "targets": [
            {
              "datasource": { "type": "postgres", "uid": "timescaledb" },
              "editorMode": "code",
              "format": "table",
              "rawQuery": true,
              "rawSql": "SELECT COALESCE(value_text, value_num::text) AS \"unit\"\nFROM collector.samples\nWHERE tag_id IN ('${structure}_sunit', '${structure}_unit')\nORDER BY time DESC\nLIMIT 1",
              "refId": "A"
            }
          ],
          "title": "Unit",
          "type": "stat"
        },
        {
          "datasource": { "type": "postgres", "uid": "timescaledb" },
          "fieldConfig": {
