{
  "annotations": { "list": [] },
  "description": "Template: pick OPC structure root once → gauge/trend for value with min/max scale and unit. Supports Siemens (rValueOut/strScale/sUnit) and generic (realValue/min Scale/max Scale/unit) sanitized tag_ids.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "description": "Latest value. Axis min/max from scale tags (Config from query).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "timescaledb" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time AS \"time\",\n  value_num AS \"value\"\nFROM collector.samples\nWHERE\n  tag_id IN ('${structure}_rvalueout', '${structure}_realvalue')\n  AND $__timeFilter(time)\nORDER BY 1",
          "refId": "A"
        },
        {
          "datasource": { "type": "postgres", "uid": "timescaledb" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT value_num AS \"min\"\nFROM collector.samples\nWHERE tag_id IN ('${structure}_strscale_min', '${structure}_min_scale')\nORDER BY time DESC\nLIMIT 1",
          "refId": "Min"
        },
        {
          "datasource": { "type": "postgres", "uid": "timescaledb" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT value_num AS \"max\"\nFROM collector.samples\nWHERE tag_id IN ('${structure}_strscale_max', '${structure}_max_scale')\nORDER BY time DESC\nLIMIT 1",
          "refId": "Max"
        }
      ],
      "title": "Value — ${structure:text}",
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "Min",
            "mappings": [
              {
                "fieldName": "min",
                "handlerKey": "min",
                "reducerId": "lastNotNull"
              }
            ]
          }
        },
        {
          "id": "configFromData",
          "options": {
            "configRefId": "Max",
            "mappings": [
              {
                "fieldName": "max",
                "handlerKey": "max",
                "reducerId": "lastNotNull"
              }
            ]
          }
        }
      ],
      "type": "gauge"
    },
    {
      "datasource": { "type": "postgres", "uid": "timescaledb" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
