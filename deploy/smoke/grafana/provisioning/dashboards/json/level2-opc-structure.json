  "templating": {
    "list": [
      {
        "allValue": "",
        "allowCustomValue": true,
        "current": {},
        "datasource": { "type": "postgres", "uid": "timescaledb" },
        "definition": "SELECT\n  regexp_replace(tag_id, '_(rvalueout|realvalue)$', '') AS __value,\n  regexp_replace(\n    regexp_replace(tag_id, '_(rvalueout|realvalue)$', ''),\n    '^objects_serverinterfaces_',\n    ''\n  ) AS __text\nFROM collector.samples\nWHERE time > NOW() - INTERVAL '1 hour'\n  AND tag_id ~ '_(rvalueout|realvalue)$'\nGROUP BY 1, 2\nORDER BY 2",
        "description": "OPC structure root. Dropdown shows short label (without objects_serverinterfaces_); query value stays the full sanitized prefix. Custom paste still uses the full prefix.",
        "hide": 0,
        "includeAll": false,
        "label": "Structure",
        "multi": false,
        "name": "structure",
        "options": [],
        "query": "SELECT\n  regexp_replace(tag_id, '_(rvalueout|realvalue)$', '') AS __value,\n  regexp_replace(\n    regexp_replace(tag_id, '_(rvalueout|realvalue)$', ''),\n    '^objects_serverinterfaces_',\n    ''\n  ) AS __text\nFROM collector.samples\nWHERE time > NOW() - INTERVAL '1 hour'\n  AND tag_id ~ '_(rvalueout|realvalue)$'\nGROUP BY 1, 2\nORDER BY 2",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
