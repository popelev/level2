# Lab defaults for Jenkins (deploy/ci). Copy to .env and adjust.
#   cp deploy/ci/.env.example deploy/ci/.env
#
# Do NOT commit .env. Do NOT use these passwords outside the lab VM.

# Jenkins UI admin (local security realm via JCasC)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# Public URL shown in Jenkins (change to http://<vm-lan-ip>:8081/ if needed)
JENKINS_URL=http://localhost:8081/

# Host path for Jenkins home (must match inside the container for sibling docker.sock mounts)
JENKINS_HOME_HOST=/home/level2/jenkins_home

# Multibranch SCM
GITHUB_REPO_URL=https://github.com/popelev/level2.git

# Optional: GitHub PAT for private repos, PR discovery, or API rate limits.
# Leave empty for public https://github.com/popelev/level2 (anonymous clone).
# When set, CasC stores it as secret text credential id "github-pat".
# Attach that credential to the Multibranch git source if clone/scan requires auth.
GITHUB_PAT=
GITHUB_CREDENTIALS_ID=github-pat
