POSTGRES_USER=level2
POSTGRES_PASSWORD=level2_change_me
POSTGRES_DB=level2
PLC_OPC_ENDPOINT=opc.tcp://10.14.10.16:4840
OPC_UA_USERNAME=
OPC_UA_PASSWORD=
# PLC-off: in-memory browse/expand + synthetic tag samples (set 0 when real PLC is on)
LEVEL2_SIM_BROWSER=1
# Opt-in synthetic tags without full sim browser (default off; NEVER auto on OPC disconnect).
# Prefer this over leaving SIM_BROWSER=1 when you only need samples. Requires collector recreate.
# LEVEL2_TAG_SIMULATION=false
# Allow PUT/POST tag value → OPC Write (default off). Set true only on intentional lab/plant setups.
# LEVEL2_OPC_WRITE_ENABLED=false
# Optional shared API token for mutating /api/v1 + WS (empty = auth disabled).
# LEVEL2_API_TOKEN=
# Optional: absolute capacity limit (bytes). Overrides Statfs-based percent limit.
# LEVEL2_DB_CAPACITY_BYTES=
# Soft limit as % of disk (1–100). YAML database.capacity_percent also applies.
# LEVEL2_DB_CAPACITY_PERCENT=90
# When used >= limit: stop | drop_oldest | rotate | expand_limit
# LEVEL2_DB_FULL_POLICY=stop
# Path inside collector with Timescale data volume mounted (default /var/lib/level2/dbdisk)
# LEVEL2_DB_DATA_PATH=/var/lib/level2/dbdisk
